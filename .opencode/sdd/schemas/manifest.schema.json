{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://riccon.dev/sdd/manifest.schema.json",
  "title": "Riccon SDD manifest",
  "type": "object",
  "required": ["schema_version", "team_version", "installed_at", "files"],
  "properties": {
    "schema_version": { "const": 1 },
    "team_version": { "type": "string" },
    "installed_at": { "type": "string" },
    "speckit_version": { "type": ["string", "null"] },
    "compat_range": { "type": ["string", "null"] },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "managed"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "managed": { "type": "boolean" }
        }
      }
    }
  }
}
