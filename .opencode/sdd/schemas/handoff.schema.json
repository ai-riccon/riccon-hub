{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://riccon.dev/sdd/handoff.schema.json",
  "title": "Riccon SDD handoff",
  "type": "object",
  "required": ["schema_version", "id", "summary", "next", "first_read", "phase", "created_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^HANDOFF-[0-9]{4,}$" },
    "session": { "type": ["string", "null"] },
    "summary": { "type": "string" },
    "next": { "type": "string", "minLength": 1 },
    "invariants": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "first_read": { "type": "array", "items": { "type": "string" } },
    "phase": { "type": "string" },
    "gate": { "type": ["string", "null"] },
    "gate_status": { "type": "string" },
    "created_at": { "type": "string" }
  }
}
