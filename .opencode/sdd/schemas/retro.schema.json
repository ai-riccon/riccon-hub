{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://riccon.dev/sdd/retro.schema.json",
  "title": "Riccon SDD retrospective",
  "type": "object",
  "required": ["schema_version", "id", "period", "created_at", "metrics"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^RETRO-[0-9]{4,}$" },
    "period": { "type": "string" },
    "created_at": { "type": "string" },
    "metrics": { "type": "object" }
  }
}
