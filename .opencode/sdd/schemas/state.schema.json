{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://riccon.dev/sdd/state.schema.json",
  "title": "Riccon SDD state",
  "type": "object",
  "required": ["schema_version", "team_version", "phase", "gate", "approvals", "next", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "team_version": { "type": "string" },
    "phase": { "enum": ["init", "kickoff", "specify", "plan", "tasks", "implement", "verify", "accept", "done", "blocked"] },
    "gate": {
      "type": "object",
      "required": ["name", "status"],
      "properties": {
        "name": { "enum": ["kickoff", "spec", "plan", "tasks", "final"] },
        "status": { "enum": ["pending", "pass", "fail"] },
        "checked_at": { "type": ["string", "null"] },
        "message": { "type": "string" }
      }
    },
    "current_feature": { "type": ["string", "null"] },
    "current_story": { "type": ["string", "null"] },
    "active_task": { "type": ["string", "null"] },
    "approvals": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "enum": ["pending", "approved", "rejected"] },
          "decision_id": { "type": ["string", "null"] },
          "at": { "type": ["string", "null"] }
        }
      }
    },
    "next": { "type": "string", "minLength": 1 },
    "health": { "type": "string" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}
