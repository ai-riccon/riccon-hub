{
  "name": "riccon-agents-sdd",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Riccon SDD — a spec-kit driven OpenCode agent team for greenfield software delivery",
  "bin": {
    "sdd": "./scripts/sdd.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "sync:agents": "node scripts/sync-agents.mjs",
    "install:dry": "node scripts/sdd.mjs init --dry-run",
    "install:global": "npm link",
    "uninstall:global": "npm unlink -g riccon-agents-sdd"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "ajv": "^8.20.0"
  }
}
